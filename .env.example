# Copy to .env.local (gitignored). Both are optional — the console degrades
# gracefully and tells you which integration is missing its key.

# n8n public API key: n8n UI -> Settings -> n8n API -> Create key
N8N_API_KEY=

# Odysseus API token (starts with ody_): Odysseus UI -> Settings -> API tokens
ODYSSEUS_TOKEN=

# Set to 1 to run entirely on fixture data (public demo / screenshots)
# DEMO=1
